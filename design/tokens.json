  "radius": {
    "$type": "dimension",
    "sm": {
      "$description": "Buttons, fields, badges, and menu items.",
      "$value": { "value": 0.35, "unit": "rem" }
    },
    "md": {
      "$description": "Cards and large fields.",
      "$value": { "value": 0.65, "unit": "rem" }
    },
    "lg": {
      "$description": "Panels, dialogs, and the composer.",
      "$value": { "value": 0.9, "unit": "rem" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "panel": {
      "$description": "Elevation of floating panels and dialogs.",
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.34, "hex": "#000000" },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 24, "unit": "px" },
        "blur": { "value": 70, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    }
  },
  "transition": {
    "$type": "transition",
    "fast": {
      "$description": "Colour, border, and small movement changes on hover and focus.",
      "$value": {
        "duration": { "value": 140, "unit": "ms" },
