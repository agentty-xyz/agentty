{
  "$description": "Every design token of Agentty's web surfaces and native apps, in the W3C Design Tokens format. A token's $value is the green theme, the default; its xyz.agentty.theme extension holds the dark theme's value where that differs, and its xyz.agentty.highContrast extension holds the value in each theme, green and dark, that replaces it when the system asks for more contrast. Tokens outside surfaces are shared by every surface. A value that only one surface uses lives under surfaces.<surface> and keeps the same name; a token there that repeats a shared name replaces the shared value for that surface alone. Scales for type, spacing, column widths, and control heights are tokens too; sizes that belong to one surface's layout, such as its sidebar width, and tokens derived from other tokens stay in the stylesheet that uses them. The xyz.agentty.fontFaces extension lists the self-hosted font faces that the generated fonts.css embeds, each with its WOFF2 file and licence text relative to this file and the copyright and licence notice the stylesheet repeats; the xyz.agentty.contrast extension lists the colour pairs that must reach a WCAG 2 contrast minimum in every theme, at standard and at high contrast, or only at the one level, standard or high, that a pair group's contrast field names.",
  "color": {
    "$type": "color",
    "bg": {
      "$description": "Page background.",
      "$value": { "colorSpace": "srgb", "components": [0.0275, 0.0431, 0.0314], "hex": "#070b08" },
      "$extensions": {
        "xyz.agentty.theme": {
          "dark": { "colorSpace": "srgb", "components": [0.0314, 0.0314, 0.0314], "hex": "#080808" }
        }
      }
    },
    "surface": {
      "$description": "Inset surfaces: inputs, inline code, badges, and switches.",
      "$value": { "colorSpace": "srgb", "components": [0.051, 0.0824, 0.0627], "hex": "#0d1510" },
      "$extensions": {
        "xyz.agentty.theme": {
          "dark": { "colorSpace": "srgb", "components": [0.0667, 0.0667, 0.0667], "hex": "#111111" }
        }
