      "$extensions": {
        "xyz.agentty.theme": {
          "dark": { "colorSpace": "srgb", "components": [0.7843, 0.7843, 0.7843], "hex": "#c8c8c8" }
        },
        "xyz.agentty.highContrast": {
          "green": { "colorSpace": "srgb", "components": [0.5255, 0.7882, 0.5843], "hex": "#86c995" },
          "dark": { "colorSpace": "srgb", "components": [0.7843, 0.7843, 0.7843], "hex": "#c8c8c8" }
