    },
    "scrim": {
      "$description": "Backdrop behind dialogs, sheets, and menus.",
      "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.72, "hex": "#000000" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$description": "Body text and headings.",
      "$value": ["Inter", "ui-sans-serif", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"]
    },
    "mono": {
      "$description": "Code, navigation, labels, and the brand name, on every surface. Share Tech Mono is self-hosted by the generated fonts.css; system monospace faces and then Courier New stand in while it loads.",
      "$value": ["Share Tech Mono", "ui-monospace", "SF Mono", "SFMono-Regular", "Menlo", "Consolas", "Courier New", "monospace"]
    }
  },
  "font-size": {
    "$type": "dimension",
    "$description": "Type scale. Body text is body; the steps below it set labels, metadata, and controls, and the steps above it set lead text and headings.",
    "3xs": { "$description": "Keycaps, badges, and the smallest metadata.", "$value": { "value": 0.68, "unit": "rem" } },
    "2xs": { "$description": "Eyebrows, window bars, and status labels.", "$value": { "value": 0.72, "unit": "rem" } },
    "xs": { "$description": "Navigation, small labels, and search hints.", "$value": { "value": 0.78, "unit": "rem" } },
    "sm": { "$description": "Field labels, table text, and compact controls.", "$value": { "value": 0.82, "unit": "rem" } },
    "md": { "$description": "Buttons and secondary text in lists.", "$value": { "value": 0.86, "unit": "rem" } },
    "lg": { "$description": "Descriptions and supporting prose in panels.", "$value": { "value": 0.92, "unit": "rem" } },
    "body": { "$description": "Body text and form input.", "$value": { "value": 1, "unit": "rem" } },
    "xl": { "$description": "Lead paragraphs and the brand name.", "$value": { "value": 1.1, "unit": "rem" } },
    "2xl": { "$description": "Dialog and panel titles.", "$value": { "value": 1.35, "unit": "rem" } },
    "3xl": { "$description": "Large display figures, such as a pairing code.", "$value": { "value": 2, "unit": "rem" } }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": { "$description": "Body text.", "$value": 400 },
    "medium": { "$description": "Emphasis inside tables.", "$value": 500 },
    "semibold": { "$description": "Buttons, the brand name, and strong labels.", "$value": 600 },
    "heading": { "$description": "Section and content headings.", "$value": 650 },
    "bold": { "$description": "Page titles and the strongest emphasis.", "$value": 700 }
  },
  "line-height": {
    "$type": "number",
    "$description": "Line heights as multiples of the font size, from display headings to relaxed prose.",
    "none": { "$description": "Single-line controls and display headings.", "$value": 1 },
    "tight": { "$description": "Large headings.", "$value": 1.1 },
    "snug": { "$description": "Small headings and labels that may wrap.", "$value": 1.25 },
    "compact": { "$description": "Metadata, cards, and inline code.", "$value": 1.4 },
    "normal": { "$description": "Tables, notices, and buttons with text.", "$value": 1.5 },
    "body": { "$description": "Body text and code blocks.", "$value": 1.6 },
    "relaxed": { "$description": "Lead paragraphs and long answers.", "$value": 1.7 }
  },
  "tracking": {
    "$type": "number",
    "$description": "Letter spacing in em, which a DTCG dimension cannot express, so each token names its unit in the xyz.agentty.unit extension. Headings tighten as they grow; uppercase labels open up.",
    "tightest": { "$description": "The largest display heading.", "$value": -0.055, "$extensions": { "xyz.agentty.unit": "em" } },
    "tighter": { "$description": "Page titles.", "$value": -0.045, "$extensions": { "xyz.agentty.unit": "em" } },
    "tight": { "$description": "Section titles.", "$value": -0.035, "$extensions": { "xyz.agentty.unit": "em" } },
    "snug": { "$description": "Small headings and dialog titles.", "$value": -0.025, "$extensions": { "xyz.agentty.unit": "em" } },
    "wide": { "$description": "The brand name and monospace headings.", "$value": 0.02, "$extensions": { "xyz.agentty.unit": "em" } },
    "wider": { "$description": "Uppercase group and table labels.", "$value": 0.04, "$extensions": { "xyz.agentty.unit": "em" } },
    "widest": { "$description": "Eyebrows and other uppercase captions.", "$value": 0.08, "$extensions": { "xyz.agentty.unit": "em" } }
  },
  "space": {
    "$type": "dimension",
    "$description": "Spacing scale for padding, margins, and gaps: the smallest steps sit inside controls, the middle ones between related items, and the largest between groups and sections.",
    "3xs": { "$value": { "value": 0.15, "unit": "rem" } },
    "2xs": { "$value": { "value": 0.25, "unit": "rem" } },
    "xs": { "$value": { "value": 0.35, "unit": "rem" } },
    "sm": { "$value": { "value": 0.5, "unit": "rem" } },
    "md": { "$value": { "value": 0.75, "unit": "rem" } },
    "lg": { "$value": { "value": 1, "unit": "rem" } },
    "xl": { "$value": { "value": 1.25, "unit": "rem" } },
    "2xl": { "$value": { "value": 1.5, "unit": "rem" } },
    "3xl": { "$value": { "value": 2, "unit": "rem" } },
    "4xl": { "$value": { "value": 3, "unit": "rem" } },
    "5xl": { "$value": { "value": 4, "unit": "rem" } }
  },
  "width": {
    "$type": "dimension",
    "$description": "Column widths.",
    "reading": { "$description": "A documentation article or a chat column.", "$value": { "value": 760, "unit": "px" } },
    "prose": { "$description": "A prose page.", "$value": { "value": 800, "unit": "px" } },
    "wide": { "$description": "Wide sections, such as feature grids.", "$value": { "value": 960, "unit": "px" } },
    "docs": { "$description": "Documentation with its sidebars.", "$value": { "value": 1240, "unit": "px" } }
  },
  "control-height": {
    "$type": "dimension",
    "$description": "Minimum heights of controls, so they stay easy to hit.",
