      "$value": { "colorSpace": "srgb", "components": [0.0706, 0.1176, 0.0863], "hex": "#121e16" },
      "$extensions": {
        "xyz.agentty.theme": {
          "dark": { "colorSpace": "srgb", "components": [0.0902, 0.0902, 0.0902], "hex": "#171717" }
        }
      }
    },
    "surface-interactive": {
