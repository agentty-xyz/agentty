    "sm": { "$description": "Compact buttons beside content, such as copy and close.", "$value": { "value": 2, "unit": "rem" } },
    "md": { "$description": "Every other control, at least.", "$value": { "value": 2.15, "unit": "rem" } },
    "lg": { "$description": "Primary actions, fields, and every control on touch layouts.", "$value": { "value": 2.75, "unit": "rem" } },
    "xl": { "$description": "Search and code entry fields.", "$value": { "value": 3.25, "unit": "rem" } }
