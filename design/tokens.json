{
  "$description": "Every design value of Agentty's web surfaces, in the W3C Design Tokens format. A token's $value is the green theme, the default; its xyz.agentty.theme extension holds the dark theme's value where that differs. Tokens outside surfaces are shared by every surface. A value that only one surface uses lives under surfaces.<surface> and keeps the same name; a token there that repeats a shared name replaces the shared value for that surface alone. Layout sizes and tokens derived from other tokens stay in the stylesheet that uses them.",
  "color": {
    "$type": "color",
    "bg": {
      "$description": "Page background.",
      "$value": { "colorSpace": "srgb", "components": [0.0275, 0.0431, 0.0314], "hex": "#070b08" },
      "$extensions": {
        "xyz.agentty.theme": {
          "dark": { "colorSpace": "srgb", "components": [0.0314, 0.0314, 0.0314], "hex": "#080808" }
        }
      }
    },
    "surface": {
      "$description": "Inset surfaces: inputs, inline code, badges, and switches.",
      "$value": { "colorSpace": "srgb", "components": [0.051, 0.0824, 0.0627], "hex": "#0d1510" },
      "$extensions": {
        "xyz.agentty.theme": {
          "dark": { "colorSpace": "srgb", "components": [0.0667, 0.0667, 0.0667], "hex": "#111111" }
        }
      }
    },
    "surface-raised": {
      "$description": "Panels, cards, dialogs, menus, and secondary buttons.",
      "$value": { "colorSpace": "srgb", "components": [0.0706, 0.1176, 0.0863], "hex": "#121e16" },
      "$extensions": {
        "xyz.agentty.theme": {
          "dark": { "colorSpace": "srgb", "components": [0.0902, 0.0902, 0.0902], "hex": "#171717" }
        }
      }
    },
    "surface-interactive": {
      "$description": "Hovered, pressed, and selected controls.",
      "$value": { "colorSpace": "srgb", "components": [0.0902, 0.1529, 0.1098], "hex": "#17271c" },
      "$extensions": {
        "xyz.agentty.theme": {
          "dark": { "colorSpace": "srgb", "components": [0.1176, 0.1176, 0.1176], "hex": "#1e1e1e" }
        }
      }
    },
    "text": {
      "$description": "Body text and headings.",
      "$value": { "colorSpace": "srgb", "components": [0.8471, 0.9686, 0.8745], "hex": "#d8f7df" },
      "$extensions": {
        "xyz.agentty.theme": {
          "dark": { "colorSpace": "srgb", "components": [0.9412, 0.9412, 0.9412], "hex": "#f0f0f0" }
        }
      }
    },
    "accent": {
      "$description": "Links, the brand mark, primary actions, and the ready status.",
      "$value": { "colorSpace": "srgb", "components": [0.2902, 0.8941, 0.4667], "hex": "#4ae477" },
      "$extensions": {
        "xyz.agentty.theme": {
          "dark": { "colorSpace": "srgb", "components": [0.9569, 0.9569, 0.9569], "hex": "#f4f4f4" }
        }
      }
    },
    "accent-dim": {
      "$description": "Quieter accent: hover outlines and the queued status.",
      "$value": { "colorSpace": "srgb", "components": [0.4706, 0.7059, 0.5255], "hex": "#78b486" },
      "$extensions": {
        "xyz.agentty.theme": {
          "dark": { "colorSpace": "srgb", "components": [0.7843, 0.7843, 0.7843], "hex": "#c8c8c8" }
        }
      }
    },
    "muted": {
      "$description": "Secondary text: descriptions, navigation, and labels.",
      "$value": { "colorSpace": "srgb", "components": [0.4235, 0.6471, 0.4745], "hex": "#6ca579" },
      "$extensions": {
        "xyz.agentty.theme": {
          "dark": { "colorSpace": "srgb", "components": [0.6784, 0.6784, 0.6784], "hex": "#adadad" }
        }
      }
    },
    "dim": {
      "$description": "Tertiary text: metadata, placeholders, and the idle status.",
      "$value": { "colorSpace": "srgb", "components": [0.3569, 0.549, 0.4039], "hex": "#5b8c67" },
      "$extensions": {
        "xyz.agentty.theme": {
          "dark": { "colorSpace": "srgb", "components": [0.5686, 0.5686, 0.5686], "hex": "#919191" }
        }
      }
    },
    "border": {
      "$description": "Dividers and the outlines of panels and fields.",
      "$value": { "colorSpace": "srgb", "components": [0.1608, 0.2941, 0.1922], "hex": "#294b31" },
      "$extensions": {
        "xyz.agentty.theme": {
          "dark": { "colorSpace": "srgb", "components": [0.2, 0.2, 0.2], "hex": "#333333" }
        }
      }
    },
    "border-strong": {
      "$description": "Outlines that must stand out: buttons, dialogs, and prominent fields.",
      "$value": { "colorSpace": "srgb", "components": [0.2667, 0.4784, 0.3098], "hex": "#447a4f" },
      "$extensions": {
        "xyz.agentty.theme": {
          "dark": { "colorSpace": "srgb", "components": [0.3647, 0.3647, 0.3647], "hex": "#5d5d5d" }
        }
      }
    },
    "focus": {
      "$description": "Keyboard focus ring.",
      "$value": { "colorSpace": "srgb", "components": [0.6039, 0.9569, 0.702], "hex": "#9af4b3" },
      "$extensions": {
        "xyz.agentty.theme": {
          "dark": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }
        }
      }
    },
    "error": {
      "$description": "Errors, destructive actions, and the failed status.",
      "$value": { "colorSpace": "srgb", "components": [1, 0.6235, 0.6235], "hex": "#ff9f9f" }
    },
    "on-accent": {
      "$description": "Text and icons on an accent fill.",
      "$value": { "colorSpace": "srgb", "components": [0.0235, 0.0627, 0.0353], "hex": "#061009" }
    },
    "roadmap-future": {
      "$description": "Warm highlight: upcoming roadmap work and the working status.",
      "$value": { "colorSpace": "srgb", "components": [0.9098, 0.7686, 0.3529], "hex": "#e8c45a" }
    },
    "roadmap-horizon": {
      "$description": "Cool highlight: later roadmap work and the asking status.",
      "$value": { "colorSpace": "srgb", "components": [0.7176, 0.6431, 1], "hex": "#b7a4ff" }
    },
    "scrim": {
      "$description": "Backdrop behind dialogs, sheets, and menus.",
      "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.72, "hex": "#000000" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$description": "Body text and headings.",
      "$value": ["Inter", "ui-sans-serif", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"]
    },
    "mono": {
      "$description": "Code, navigation, labels, and the brand name. Share Tech Mono is a web font; pages that load it fall back to Courier New.",
      "$value": ["Share Tech Mono", "Courier New", "monospace"]
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$description": "Buttons, fields, badges, and menu items.",
      "$value": { "value": 0.35, "unit": "rem" }
    },
    "md": {
      "$description": "Cards and large fields.",
      "$value": { "value": 0.65, "unit": "rem" }
    },
    "lg": {
      "$description": "Panels, dialogs, and the composer.",
      "$value": { "value": 0.9, "unit": "rem" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "panel": {
      "$description": "Elevation of floating panels and dialogs.",
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.34, "hex": "#000000" },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 24, "unit": "px" },
        "blur": { "value": 70, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    }
  },
  "transition": {
    "$type": "transition",
    "fast": {
      "$description": "Colour, border, and small movement changes on hover and focus.",
      "$value": {
        "duration": { "value": 140, "unit": "ms" },
        "delay": { "value": 0, "unit": "ms" },
        "timingFunction": [0.25, 0.1, 0.25, 1]
      }
    }
  },
  "surfaces": {
    "docs-site": {
      "$description": "Values only the documentation site uses.",
      "color": {
        "$type": "color",
        "control-hover": {
          "$description": "Faint wash behind hovered diagram controls.",
          "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.02, "hex": "#ffffff" }
        },
        "demo-frame": {
          "$description": "Backdrop of feature demo recordings, matching their terminal background.",
          "$value": { "colorSpace": "srgb", "components": [0.1176, 0.1176, 0.1176], "hex": "#1e1e1e" }
        }
      },
      "glyph": {
        "$type": "color",
        "$description": "Brightness ramp of the animated glyph art, from the faintest cell to the brightest, plus the highlighted cell.",
        "0": {
          "$value": { "colorSpace": "srgb", "components": [0.1098, 0.2275, 0.1412], "hex": "#1c3a24" },
          "$extensions": {
            "xyz.agentty.theme": {
              "dark": { "colorSpace": "srgb", "components": [0.149, 0.149, 0.149], "hex": "#262626" }
            }
          }
        },
        "1": {
          "$value": { "colorSpace": "srgb", "components": [0.1412, 0.3137, 0.1843], "hex": "#24502f" },
          "$extensions": {
            "xyz.agentty.theme": {
              "dark": { "colorSpace": "srgb", "components": [0.2118, 0.2118, 0.2118], "hex": "#363636" }
            }
          }
        },
        "2": {
          "$value": { "colorSpace": "srgb", "components": [0.1843, 0.4157, 0.2392], "hex": "#2f6a3d" },
          "$extensions": {
            "xyz.agentty.theme": {
              "dark": { "colorSpace": "srgb", "components": [0.2902, 0.2902, 0.2902], "hex": "#4a4a4a" }
            }
          }
        },
        "3": {
          "$value": { "colorSpace": "srgb", "components": [0.2471, 0.5412, 0.3137], "hex": "#3f8a50" },
          "$extensions": {
            "xyz.agentty.theme": {
              "dark": { "colorSpace": "srgb", "components": [0.3922, 0.3922, 0.3922], "hex": "#646464" }
            }
          }
        },
        "4": {
          "$value": { "colorSpace": "srgb", "components": [0.3412, 0.6784, 0.4118], "hex": "#57ad69" },
          "$extensions": {
            "xyz.agentty.theme": {
              "dark": { "colorSpace": "srgb", "components": [0.5216, 0.5216, 0.5216], "hex": "#858585" }
            }
          }
        },
        "5": {
          "$value": { "colorSpace": "srgb", "components": [0.498, 0.8078, 0.5569], "hex": "#7fce8e" },
          "$extensions": {
            "xyz.agentty.theme": {
              "dark": { "colorSpace": "srgb", "components": [0.6588, 0.6588, 0.6588], "hex": "#a8a8a8" }
            }
          }
        },
        "6": {
          "$value": { "colorSpace": "srgb", "components": [0.702, 0.9098, 0.7412], "hex": "#b3e8bd" },
          "$extensions": {
            "xyz.agentty.theme": {
              "dark": { "colorSpace": "srgb", "components": [0.8118, 0.8118, 0.8118], "hex": "#cfcfcf" }
            }
          }
        },
        "7": {
          "$value": { "colorSpace": "srgb", "components": [0.8941, 0.9843, 0.9098], "hex": "#e4fbe8" },
          "$extensions": {
            "xyz.agentty.theme": {
              "dark": { "colorSpace": "srgb", "components": [0.9569, 0.9569, 0.9569], "hex": "#f4f4f4" }
            }
          }
        },
        "hot": {
          "$value": { "colorSpace": "srgb", "components": [0.2902, 0.8941, 0.4667], "hex": "#4ae477" },
          "$extensions": {
            "xyz.agentty.theme": {
              "dark": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }
            }
          }
        }
      },
      "shadow": {
        "$type": "shadow",
        "logo": {
          "$description": "Glow around the text logo.",
          "$value": {
            "color": { "colorSpace": "srgb", "components": [0.2392, 0.8667, 0.4157], "alpha": 0.4, "hex": "#3ddd6a" },
            "offsetX": { "value": 0, "unit": "px" },
            "offsetY": { "value": 0, "unit": "px" },
            "blur": { "value": 12, "unit": "px" },
            "spread": { "value": 0, "unit": "px" }
          },
          "$extensions": {
            "xyz.agentty.theme": {
              "dark": {
                "color": { "colorSpace": "srgb", "components": [0.8784, 0.8784, 0.8784], "alpha": 0.2, "hex": "#e0e0e0" },
                "offsetX": { "value": 0, "unit": "px" },
                "offsetY": { "value": 0, "unit": "px" },
                "blur": { "value": 12, "unit": "px" },
                "spread": { "value": 0, "unit": "px" }
              }
            }
          }
        }
      }
    },
    "remote-client": {
      "$description": "Values only the remote-control web client uses.",
      "font": {
        "$type": "fontFamily",
        "mono": {
          "$description": "The client loads no web fonts, so system monospace fonts come before Courier New.",
          "$value": ["Share Tech Mono", "ui-monospace", "SF Mono", "SFMono-Regular", "Menlo", "Consolas", "Courier New", "monospace"]
        }
      }
    }
  },
  "$extensions": {
    "xyz.agentty.contrast": [
      {
        "use": "Text on every solid surface",
        "minimum": 4.5,
        "foregrounds": ["{color.text}", "{color.accent}", "{color.accent-dim}", "{color.muted}", "{color.dim}", "{color.error}", "{color.roadmap-future}", "{color.roadmap-horizon}"],
        "backgrounds": ["{color.bg}", "{color.surface}", "{color.surface-raised}", "{color.surface-interactive}"],
        "shortfalls": [
          {
            "theme": "green",
            "foreground": "{color.dim}",
            "background": "{color.surface-raised}",
            "ratio": 4.41,
            "reason": "Metadata and placeholders inside raised panels, such as dialog footers and search status lines, use dim text."
          },
          {
            "theme": "green",
            "foreground": "{color.dim}",
            "background": "{color.surface-interactive}",
            "ratio": 4.01,
            "reason": "Option hints and suggestion details stay dim when their row is selected or highlighted."
          }
        ]
      },
      {
        "use": "Labels on a primary button, which fills with the focus colour on hover",
        "minimum": 4.5,
        "foregrounds": ["{color.on-accent}"],
        "backgrounds": ["{color.accent}", "{color.focus}"]
      },
      {
        "use": "Focus rings, status dots, and primary button fills",
        "minimum": 3,
        "foregrounds": ["{color.focus}", "{color.accent}", "{color.accent-dim}", "{color.dim}", "{color.error}", "{color.roadmap-future}", "{color.roadmap-horizon}"],
        "backgrounds": ["{color.bg}", "{color.surface}", "{color.surface-raised}", "{color.surface-interactive}"]
      },
      {
        "use": "Outlines of form fields",
        "minimum": 3,
        "foregrounds": ["{color.border}", "{color.border-strong}"],
        "backgrounds": ["{color.bg}", "{color.surface}", "{color.surface-raised}"],
        "shortfalls": [
          {
            "theme": "green",
            "foreground": "{color.border}",
            "background": "{color.bg}",
            "ratio": 2.02,
            "reason": "Text fields and the session filter outline their page-coloured fill with the ordinary border."
          },
          {
            "theme": "green",
            "foreground": "{color.border}",
            "background": "{color.surface}",
            "ratio": 1.9,
            "reason": "The documentation search field outlines its inset fill with the ordinary border."
          },
          {
            "theme": "green",
            "foreground": "{color.border}",
            "background": "{color.surface-raised}",
            "ratio": 1.75,
            "reason": "Text fields inside raised panels, such as the pairing form, use the ordinary border."
          },
          {
            "theme": "dark",
            "foreground": "{color.border}",
            "background": "{color.bg}",
            "ratio": 1.59,
            "reason": "Text fields and the session filter outline their page-coloured fill with the ordinary border."
          },
          {
            "theme": "dark",
            "foreground": "{color.border}",
            "background": "{color.surface}",
            "ratio": 1.49,
            "reason": "The documentation search field outlines its inset fill with the ordinary border."
          },
          {
            "theme": "dark",
            "foreground": "{color.border}",
            "background": "{color.surface-raised}",
            "ratio": 1.42,
            "reason": "Text fields inside raised panels, such as the pairing form, use the ordinary border."
          },
          {
            "theme": "dark",
            "foreground": "{color.border-strong}",
            "background": "{color.surface}",
            "ratio": 2.87,
            "reason": "The composer outlines its inset fill with the strong border."
          },
          {
            "theme": "dark",
            "foreground": "{color.border-strong}",
            "background": "{color.surface-raised}",
            "ratio": 2.72,
            "reason": "The pairing code and site search fields sit inside raised panels."
          }
        ]
      }
    ]
  }
}
