  "$extensions": {
    "xyz.agentty.fontFaces": [
      {
        "family": "Share Tech Mono",
        "style": "normal",
        "weight": 400,
        "source": "fonts/ShareTechMono-Regular.woff2",
        "license": "fonts/OFL.txt",
        "notice": "Copyright (c) 2012, Carrois Type Design, Ralph du Carrois (post@carrois.com www.carrois.com), with Reserved Font Name 'Share'. This Font Software is licensed under the SIL Open Font License, Version 1.1."
      }
    ],
    "xyz.agentty.contrast": [
      {
        "use": "Text on every solid surface",
        "minimum": 4.5,
        "foregrounds": ["{color.text}", "{color.accent}", "{color.accent-dim}", "{color.muted}", "{color.dim}", "{color.error}", "{color.roadmap-future}", "{color.roadmap-horizon}"],
        "backgrounds": ["{color.bg}", "{color.surface}", "{color.surface-raised}", "{color.surface-interactive}"]
      },
      {
        "use": "Secondary text, tertiary text, and the quieter accent when the system asks for more contrast",
        "contrast": "high",
        "minimum": 7,
        "foregrounds": ["{color.muted}", "{color.dim}", "{color.accent-dim}"],
        "backgrounds": ["{color.bg}", "{color.surface}", "{color.surface-raised}", "{color.surface-interactive}"]
      },
      {
        "use": "Labels on a primary button, which fills with the focus colour on hover",
        "minimum": 4.5,
        "foregrounds": ["{color.on-accent}"],
        "backgrounds": ["{color.accent}", "{color.focus}"]
      },
      {
        "use": "Labels on the native apps' Material fills: tertiary, tertiaryFixed, and tertiaryFixedDim in the quieter accent, and error",
        "minimum": 4.5,
        "foregrounds": ["{color.on-accent}"],
        "backgrounds": ["{color.accent-dim}", "{color.error}"]
      },
      {
        "use": "Text and actions on the native apps' inverse surface, in the body text colour",
        "minimum": 4.5,
        "foregrounds": ["{color.bg}", "{color.on-accent}"],
        "backgrounds": ["{color.text}"]
      },
      {
        "use": "Focus rings, status dots, and primary button fills",
        "minimum": 3,
        "foregrounds": ["{color.focus}", "{color.accent}", "{color.accent-dim}", "{color.dim}", "{color.error}", "{color.roadmap-future}", "{color.roadmap-horizon}"],
        "backgrounds": ["{color.bg}", "{color.surface}", "{color.surface-raised}", "{color.surface-interactive}"]
      },
      {
        "use": "Boundaries of form fields and of the native apps' unchecked switch tracks, against their fill and what surrounds them",
        "minimum": 3,
        "foregrounds": ["{color.border-strong}"],
        "backgrounds": ["{color.bg}", "{color.surface}", "{color.surface-raised}", "{color.surface-interactive}"]
      }
    ]
  }
}
