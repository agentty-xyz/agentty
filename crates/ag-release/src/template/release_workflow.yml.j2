# Generated by `ag-release workflow`; do not edit. Change the release through
# `[workspace.metadata.release]` in the workspace `Cargo.toml` and run
# `ag-release workflow` again: the `plan` job fails while this file differs
# from the generated one. Action pins (`uses: <action>@<ref> # <version>`)
# found here survive regeneration, so Dependabot can update them.
#
# Releases the workspace's apps with `ag-release`; see its README for the
# commands, the plan JSON, and the artifacts.
#
# - Pull requests and merge-queue checks run `plan`, a required check on
#   `main`. Pull requests that change release tooling also run `smoke`, which
#   builds, assembles, and installs the host target on each runner label of
#   `[workspace.metadata.release.targets]`.
# - A `workflow_dispatch` run is a dry run: it builds and assembles every
#   target with the release profile
[%- if distribution_runner.is_some() %] and installs on several Linux
#   distributions, but creates no GitHub release and publishes nothing.
[%- else %], but creates no GitHub release and
#   publishes nothing.
[%- endif %]
# - A release tag push additionally attests the artifacts and publishes the
#   GitHub release.
[%- if !check_jobs.is_empty() %]
#   It first requires the `check` jobs:
[%- for job in check_jobs %] `[= job.id =]`[% if !loop.last %],[% else %].[% endif %][% endfor %]
[%- endif %]
[%- if !publish_jobs.is_empty() %]
#   Then it runs the `publish` jobs, which skip prereleases unless configured
#   otherwise:
[%- for job in publish_jobs %] `[= job.id =]`[% if !loop.last %],[% else %].[% endif %][% endfor %]
[%- endif %]

name: Release

on:
  pull_request:
  merge_group:
    types: [checks_requested]
  push:
    tags:
      - "v[0-9]+.[0-9]+.[0-9]+*"
  workflow_dispatch:

permissions: {}

# A newer revision of a pull request supersedes its running checks; tag,
# merge-queue, and dry runs are never cancelled.
concurrency:
  group: ${{ github.workflow }}-${{ github.event_name == 'pull_request' && format('pr-{0}', github.event.pull_request.number) || github.run_id }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

env:
  CARGO_TERM_COLOR: always

defaults:
  run:
    shell: bash

jobs:
  plan:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    outputs:
      plan: ${{ steps.plan.outputs.plan }}
      smoke: ${{ steps.changes.outputs.smoke }}
      tag: ${{ steps.plan.outputs.tag }}
    steps:
      - name: Checkout
        uses: [= actions.checkout =]
        with:
          # A pull request's merge commit has the base branch as first parent.
          fetch-depth: 2
          persist-credentials: false
[% include "release_workflow_tool.yml.j2" %]

      # A tag push fails here unless the tag names the apps' version. Other
      # runs assemble and test as `v<version>`.
      - name: Plan the release
        id: plan
        env:
          PUSHED_TAG: ${{ github.event_name == 'push' && github.ref_name || '' }}
        run: |
          plan_args=()
          if [ -n "$PUSHED_TAG" ]; then
            plan_args=(--tag "$PUSHED_TAG")
          fi
          ag-release plan "${plan_args[@]}" > "$RUNNER_TEMP/plan.json"
          cat "$RUNNER_TEMP/plan.json"
          echo "plan=$(jq --compact-output . "$RUNNER_TEMP/plan.json")" >> "$GITHUB_OUTPUT"
          echo "tag=$(jq --raw-output '.tag // "v" + .version' "$RUNNER_TEMP/plan.json")" >> "$GITHUB_OUTPUT"

      # Fails when this file differs from what `ag-release workflow`
      # generates from the configuration.
      - name: Check that the release workflow is current
        run: ag-release workflow --check

      # Decided here rather than with a `paths:` filter, which would also
      # skip the required `plan` check.
      - name: Detect release tooling changes
        id: changes
        if: ${{ github.event_name == 'pull_request' }}
        run: |
          release_table() {
            local revision="$1"
            git show "$revision:Cargo.toml" |
              awk '/^\[/ { release = index($0, "[workspace.metadata.release") == 1 } release'
          }

          paths=(
[%- for path in smoke_paths %]
            [= path =]
[%- endfor %]
          )
          smoke=false
          if ! git diff --quiet HEAD^1 HEAD -- "${paths[@]}"; then
            smoke=true
          fi
          if [ "$(release_table HEAD^1)" != "$(release_table HEAD)" ]; then
            smoke=true
          fi
          echo "smoke=$smoke" >> "$GITHUB_OUTPUT"

  smoke:
    name: smoke (${{ matrix.runner }})
    needs: plan
    if: ${{ needs.plan.outputs.smoke == 'true' }}
    strategy:
      fail-fast: false
      matrix:
        runner: [= smoke_runners =]
    runs-on: ${{ matrix.runner }}
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: [= actions.checkout =]
        with:
          persist-credentials: false
[% include "release_workflow_tool.yml.j2" %]
[%- if let Some(node_version) = node_version %]

      - name: Setup Node
        uses: [= actions.setup_node =]
        with:
          node-version: [= node_version =]
          package-manager-cache: false
[%- endif %]

      # The `dev` profile keeps the build short; `assemble` and the plan
      # cover only the host target that this runner built.
      - name: Build and assemble the host target
        env:
          TAG: ${{ needs.plan.outputs.tag }}
        run: |
          target="$(rustc -vV | sed -n 's/^host: //p')"
          ag-release plan --target "$target" > "$RUNNER_TEMP/plan.json"
          ag-release build --target "$target" --profile dev --out-dir "$RUNNER_TEMP/artifacts"
          ag-release assemble --tag "$TAG" --artifacts-dir "$RUNNER_TEMP/artifacts" --target "$target"
          ag-release notes --tag "$TAG"
[%- if shell || npm %]

      # Installs every app from the local artifacts into an isolated home
      # directory, then runs each installed binary.
[%- if npm %] The npm packages under
      # test are the tarballs just assembled, so no lockfile applies.
[%- endif %]
      - name: Install through
[%- if shell %] the shell installer[% endif %]
[%- if shell && npm %] and[% endif %]
[%- if npm %] npm[% endif %]
        run: |
[%- if npm %] # zizmor: ignore[adhoc-packages][% endif %]
          artifacts="$RUNNER_TEMP/artifacts"
          export HOME="$RUNNER_TEMP/home"
          mkdir -p "$HOME"
          unset GITHUB_PATH XDG_CONFIG_HOME ZDOTDIR
          jq --raw-output '.apps[] | [.name, .shell_installer, .npm_tarball, (.binaries | join(" "))] | @tsv' \
            "$RUNNER_TEMP/plan.json" > "$RUNNER_TEMP/apps.tsv"
          while IFS=$'\t' read -r app installer tarball binaries; do
            variable="$(printf '%s' "$app" | tr 'a-z-' 'A-Z_')"
[%- if shell %]
            sh_prefix="$RUNNER_TEMP/sh/$app"
[%- endif %]
[%- if npm %]
            npm_prefix="$RUNNER_TEMP/npm/$app"
[%- endif %]
            export "${variable}_DOWNLOAD_URL=file://$artifacts"
[%- if shell %]
            env "${variable}_INSTALL_DIR=$sh_prefix" sh "$artifacts/$installer"
            test -f "$HOME/.config/$app/$app-receipt.json"
[%- endif %]
[%- if npm %]
            npm install --global --prefix "$npm_prefix" "$artifacts/$tarball"
            # The dry run validates the package first and then fails when the
            # version is already published, as it usually is on a pull request.
            if ! npm publish --dry-run --access public "$artifacts/$tarball" 2> "$RUNNER_TEMP/publish.log"; then
              cat "$RUNNER_TEMP/publish.log" >&2
              grep -q 'cannot publish over the previously published versions' "$RUNNER_TEMP/publish.log"
            fi
[%- endif %]
            for binary in $binaries; do
[%- if shell %]
              "$sh_prefix/bin/$binary" --version
[%- endif %]
[%- if npm %]
              "$npm_prefix/bin/$binary" --version
[%- endif %]
            done
          done < "$RUNNER_TEMP/apps.tsv"
[%- endif %]
[%- for job in check_jobs %]

  # A `check` job from `[workspace.metadata.release.workflow.jobs]`: tag
  # pushes only, and `host` requires it.
  [= job.id =]:
[%- if job.plan %]
    needs: plan
[%- endif %]
    if: ${{ github.event_name == 'push' }}
[%- include "release_workflow_job.yml.j2" %]
[%- endfor %]

  build:
    name: build (${{ matrix.target }})
    needs: plan
    if: ${{ github.event_name == 'push' || github.event_name == 'workflow_dispatch' }}
    strategy:
      fail-fast: false
      matrix: ${{ fromJson(needs.plan.outputs.plan).matrix }}
    runs-on: ${{ matrix.runner }}
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: [= actions.checkout =]
        with:
          persist-credentials: false
[% include "release_workflow_tool.yml.j2" %]
[%- if musl %]

      # musl targets link statically, and their C dependencies compile with
      # musl-gcc, which builds for the runner's own architecture.
      - name: Install musl tools
        if: ${{ endsWith(matrix.target, '-musl') }}
        run: |
          sudo apt-get update
          sudo apt-get install --yes --no-install-recommends musl-tools
[%- endif %]

      - name: Build archives
        env:
          TARGET: ${{ matrix.target }}
[%- if musl %]
          CC_aarch64_unknown_linux_musl: musl-gcc
          CC_x86_64_unknown_linux_musl: musl-gcc
[%- endif %]
        run: |
          rustup target add "$TARGET"
          ag-release build --target "$TARGET" --out-dir "$RUNNER_TEMP/artifacts"

      - name: Upload archives
        uses: [= actions.upload_artifact =]
        with:
          name: build-${{ matrix.target }}
          path: ${{ runner.temp }}/artifacts/
          if-no-files-found: error

  assemble:
    needs: [plan, build]
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      # `assemble` archives the checked-out commit as the source archive.
      - name: Checkout
        uses: [= actions.checkout =]
        with:
          persist-credentials: false
[% include "release_workflow_tool.yml.j2" %]

      - name: Download archives
        uses: [= actions.download_artifact =]
        with:
          pattern: build-*
          path: ${{ runner.temp }}/artifacts
          merge-multiple: true

      - name: Assemble the release
        env:
          TAG: ${{ needs.plan.outputs.tag }}
        run: |
          ag-release assemble --tag "$TAG" --artifacts-dir "$RUNNER_TEMP/artifacts"
          notes="$RUNNER_TEMP/notes"
          mkdir -p "$notes"
          ag-release notes --tag "$TAG" --title > "$notes/title.txt"
          ag-release notes --tag "$TAG" > "$notes/notes.md"
          cat "$notes/title.txt" "$notes/notes.md"

      - name: Upload release files
        uses: [= actions.upload_artifact =]
        with:
          name: release
          path: ${{ runner.temp }}/artifacts/
          if-no-files-found: error

      - name: Upload release notes
        uses: [= actions.upload_artifact =]
        with:
          name: release-notes
          path: ${{ runner.temp }}/notes/
          if-no-files-found: error
[%- if let Some(runner) = distribution_runner %]

  # Dry run only: supported distributions must install and run the Linux
  # build, and the others must fail with the installer's platform error.
  # Images use version tags instead of `latest`, which `zizmor` rejects.
  distributions:
    name: install (${{ matrix.image }})
    needs: [plan, assemble]
    if: ${{ github.event_name == 'workflow_dispatch' }}
    strategy:
      fail-fast: false
      matrix:
        include:
[%- for distribution in distributions %]
          - { image: [= distribution.image =], error: [= distribution.error =] }
[%- endfor %]
    runs-on: [= runner =]
    permissions: {}
    env:
      EXPECTED_ERROR: ${{ matrix.error }}
      IMAGE: ${{ matrix.image }}
      PLAN: ${{ needs.plan.outputs.plan }}
      # Runs in the container: adds the installer's prerequisites, then
      # installs from the mounted artifacts and runs the binary.
      CONTAINER_SCRIPT: |
        set -eu
        if command -v apt-get >/dev/null 2>&1; then
          apt-get update -qq
          DEBIAN_FRONTEND=noninteractive apt-get install -qq -y --no-install-recommends \
            ca-certificates curl tar gzip >/dev/null
        elif command -v dnf >/dev/null 2>&1; then
          dnf install -q -y ca-certificates curl tar gzip
        elif command -v apk >/dev/null 2>&1; then
          apk add -q --no-cache ca-certificates curl tar gzip
        fi
        sh "/artifacts/$INSTALLER"
        "$HOME/.cargo/bin/$BINARY" --version
    steps:
      - name: Download release files
        uses: [= actions.download_artifact =]
        with:
          name: release
          path: ${{ runner.temp }}/artifacts

      - name: Install in the container
        run: |
          jq --raw-output '.apps[] | [.name, .shell_installer, .binaries[0]] | @tsv' <<< "$PLAN" \
            > "$RUNNER_TEMP/apps.tsv"
          while IFS=$'\t' read -r app installer binary; do
            variable="$(printf '%s' "$app" | tr 'a-z-' 'A-Z_')_DOWNLOAD_URL"
            status=0
            docker run --rm --volume "$RUNNER_TEMP/artifacts:/artifacts:ro" \
              --env "$variable=file:///artifacts" --env "INSTALLER=$installer" --env "BINARY=$binary" \
              "$IMAGE" sh -c "$CONTAINER_SCRIPT" > "$RUNNER_TEMP/$app.log" 2>&1 || status=$?
            cat "$RUNNER_TEMP/$app.log"
            if [ -z "$EXPECTED_ERROR" ] && [ "$status" -ne 0 ]; then
              echo "::error::$app failed to install on $IMAGE"
              exit 1
            fi
            if [ -n "$EXPECTED_ERROR" ] && { [ "$status" -eq 0 ] ||
              ! grep -qF "$EXPECTED_ERROR" "$RUNNER_TEMP/$app.log"; }; then
              echo "::error::$app did not fail with \"$EXPECTED_ERROR\" on $IMAGE"
              exit 1
            fi
          done < "$RUNNER_TEMP/apps.tsv"
[%- endif %]

  # Tag pushes only. Running without `always()` requires every needed job,
  # and so the `check` jobs and every build, to have succeeded.
  host:
    needs: [plan, [% for job in check_jobs %][= job.id =], [% endfor %]build, assemble]
    if: ${{ github.event_name == 'push' }}
    runs-on: ubuntu-latest
    permissions:
      attestations: write
      contents: write
      id-token: write
    env:
      TAG: ${{ needs.plan.outputs.tag }}
    steps:
      - name: Download release files
        uses: [= actions.download_artifact =]
        with:
          name: release
          path: artifacts

      - name: Download release notes
        uses: [= actions.download_artifact =]
        with:
          name: release-notes
          path: ${{ runner.temp }}/notes

      - name: Attest release files
        id: attest
        uses: [= actions.attest_build_provenance =]
        with:
          subject-path: artifacts/*

      - name: Stage Sigstore bundle
        env:
          BUNDLE_PATH: ${{ steps.attest.outputs.bundle-path }}
        run: cp "$BUNDLE_PATH" "artifacts/$TAG.sigstore.json"

      # Release immutability locks a published release, so files are uploaded
      # to a draft that is published last. A retried run reuses its draft but
      # never touches a published release.
      - name: Create or reuse the GitHub release
        env:
          GH_REPO: ${{ github.repository }}
          GH_TOKEN: ${{ github.token }}
          NOTES: ${{ runner.temp }}/notes
          PRERELEASE: ${{ fromJson(needs.plan.outputs.plan).prerelease }}
        run: |
          release_args=(--title "$(cat "$NOTES/title.txt")" --notes-file "$NOTES/notes.md" \
            "--prerelease=$PRERELEASE")
          if is_draft="$(gh release view "$TAG" --json isDraft --jq .isDraft 2>/dev/null)"; then
            if [ "$is_draft" != true ]; then
              echo "release $TAG already exists and is not a draft" >&2
              exit 1
            fi
            gh release edit "$TAG" "${release_args[@]}"
          else
            gh release create "$TAG" --draft --verify-tag "${release_args[@]}"
          fi
          gh release upload "$TAG" artifacts/* --clobber
          gh release edit "$TAG" --draft=false
[%- for job in publish_jobs %]

  # A `publish` job from `[workspace.metadata.release.workflow.jobs]`: runs
  # after the GitHub release is published, [% if job.prerelease %]also[% else %]except[% endif %] for prereleases.
  [= job.id =]:
    needs: [plan, host]
[%- if job.prerelease %]
    if: ${{ github.event_name == 'push' }}
[%- else %]
    if: ${{ github.event_name == 'push' && !fromJson(needs.plan.outputs.plan).prerelease }}
[%- endif %]
[%- include "release_workflow_job.yml.j2" %]
[%- endfor %]
