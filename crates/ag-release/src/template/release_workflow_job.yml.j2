[%- if job.permissions.is_empty() %]
    permissions: {}
[%- else %]
    permissions:
[%- for (name, level) in job.permissions %]
      [= name =]: [= level =]
[%- endfor %]
[%- endif %]
    uses: [= job.uses =]
[%- if job.plan %]
    with:
      plan: ${{ needs.plan.outputs.plan }}
[%- endif %]
[%- if !job.secrets.is_empty() %]
    secrets:
[%- for secret in job.secrets %]
      [= secret =]: ${{ secrets.[= secret =] }}
[%- endfor %]
[%- endif %]
